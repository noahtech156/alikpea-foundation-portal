# Copy this to .env and edit values for your local XAMPP MySQL setup
# Use DB_DIALECT=mysql to enable MySQL (default for local dev)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alif_foundation
DB_USER=root
DB_PASSWORD=

# App
PORT=5000
JWT_SECRET=changeme_or_leave_blank

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@alikpeafoundation.org
